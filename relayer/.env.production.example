# MyDayWas relayer — production environment template (OBS-264).
# Copy to the provider secret store / runtime env at provision time.
# NEVER commit real values: no secrets in repo (managed secret bindings only).
# No value here is a secret; every secret (webhook URL, keys) is injected
# from the Paperclip secret store / provider secret manager at deploy time.

# Edge
RELAYER_PORT=8081
RELAYER_REQUIRE_TLS=1
RELAYER_RATE_PER_MIN=60

# Ops alert sink (SNS/PagerDuty ingress URL) — inject from secret store
RELAYER_ALERT_WEBHOOK=

# Durable store — persistent local volume only (single-writer WAL, CISO OBS-234)
RELAYER_DB_PATH=/data/mydaywas-relayer.db

# App build (diary): production relayer origin — non-secret, TLS only
# VITE_RELAYER_URL=https://relayer.mydaywas.com