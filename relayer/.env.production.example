# MyDayWas relayer — production environment template (OBS-264 + OBS-313 D4).
# Copy to the provider secret store / runtime env at provision time.
# NEVER commit real values: no secrets in repo (managed secret bindings only).
# Non-secret values are listed; every secret is injected from the Paperclip
# secret store / provider secret manager at deploy time.

# ---- Edge --------------------------------------------------------------------
RELAYER_PORT=8081
# TLS terminates at the LB in front of the process; the process enforces the
# edge itself: any request without x-forwarded-proto: https is rejected 426.
RELAYER_REQUIRE_TLS=1
# Per-IP token bucket on POST /v1/signals (runbook default: 60 req/min).
RELAYER_RATE_PER_MIN=60

# ---- Ops alert sink ----------------------------------------------------------
# Ops webhook (SNS/PagerDuty ingress URL). Receives every alert as
# {reason, raisedDay, detail} — reason codes + day resolution only.
# SECRET: inject from the secret store.
RELAYER_ALERT_WEBHOOK=

# ---- Durable store (F3) -------------------------------------------------------
# Persistent LOCAL volume only (SQLite WAL is local-disk; single-writer
# topology per CISO OBS-234). No network filesystems.
RELAYER_DB_PATH=/data/mydaywas-relayer.db

# ---- Custody (OBS-313 D1 / OBS-300 guard) ------------------------------------
# local-dev (default; staging only, refuses to start with RELAYER_DB_PATH set)
# | kms (production: provider-side key objects via a deploy-time adapter).
RELAYER_CUSTODY=local-dev
# KMS mode: provider tag used in versioned keyIds <provider>/<purpose>/v<n>#<fp>.
RELAYER_KMS_PROVIDER=
# The two provider-side key objects (blinder + signer; separate keys, OBS-87).
RELAYER_KMS_BLINDER_KEY_ARN=
RELAYER_KMS_SIGNER_KEY_ARN=
# Key versions for the observable keyIds (bump on rotation).
RELAYER_KMS_BLINDER_VERSION=1
RELAYER_KMS_SIGNER_VERSION=1
# Deploy-time adapter module path implementing KmsKeyOperations
# {mac, sign, verify} against the provider SDK. Never committed to the repo.
# SECRET-ADJACENT (filesystem path on the host image): inject at provision time.
RELAYER_KMS_OPS_MODULE=

# ---- Chain submitter (default DRY-RUN; cutover is CISO-gated) ----------------
# dry-run (default) | real. The real cutover additionally requires the CISO
# re-verification of the real-submitter path (OBS-166) + the OBS-237 written
# sign-off. Mainnet (chain id 1) is refused unconditionally (OBS-86).
RELAYER_SUBMITTER=dry-run
RELAYER_CHAIN_RPC=
# Expected chain id (staging Sepolia: 11155111). Production L2 choice is
# subject to its own written approval (docs/PRODUCTION-DEPLOY-MODEL.md).
RELAYER_CHAIN_ID=11155111
# AggregateSentimentSignals address (authoritative record:
# docs/CONTRACT-ADDRESSES.md).
RELAYER_CHAIN_ADDRESS=
# Relayer EOA (onlyRelayer) — public address + secret key below.
RELAYER_EOA_ADDRESS=
# SECRET: relayer EOA private key via approved managed secret binding only.
RELAYER_EOA_SECRET_KEY=

# ---- Readiness (/healthz, D2) -------------------------------------------------
# Public git sha, injected by CI/deploy (non-secret).
RELAYER_BUILD_REVISION=

# ---- App build (diary): production relayer origin — non-secret, TLS only ----
# Set at BUILD time in the diary production build (Netlify env), not here:
# VITE_RELAYER_URL=https://relayer.mydaywas.com